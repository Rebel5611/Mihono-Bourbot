FROM python:3.12-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    gcc=4:12.2.0-3 \
    libc6-dev \
    libtk8.6=8.6.13-2 \
    g++=4:12.2.0-3 \
    curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY server /server

RUN python /server/ModuleUpdate.py -y

WORKDIR /server
ENTRYPOINT [ "python3", "./Generate.py" ]